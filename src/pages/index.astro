---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const edition = 'Summer 2026';

const all = await getCollection('blog');
const byDate = [...all].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// ---------------------------------------------------------------------------
// Primary entry points — the two doors into the site.
// ---------------------------------------------------------------------------
const primary = [
  {
    key: 'cw',
    title: 'Classroom Warfare',
    type: 'Novel',
    href: 'https://flolone.com',
    external: true,
    eyebrow: 'Fiction',
    // the cover art from hero_cw.png, cropped to the illustration so the book's
    // own title plate and author plate don't collide with the overlaid title
    image: '/images/hero_cw_art.jpg',
    pos: 'center',
    alt: 'Students crowded around a single lantern in a darkened classroom, from the cover of Classroom Warfare',
    desc: 'A slow-burning school mystery — secrets, rivalries and the kind of tension that only builds in confined spaces. Read the novel at flolone.com.',
  },
  {
    key: 'pf',
    title: 'Professional Portfolio',
    type: 'Data Analytics Portfolio · Professional Work',
    href: '/portfolio',
    external: false,
    eyebrow: 'Practice',
    image: '/images/hero_hanuman.jpg',
    // biased upward so the figure's head and the red disc survive the crop at
    // every breakpoint — the canvas is much taller than any of the frames
    pos: 'center 20%',
    alt: 'Hanuman, a 1973 painting by Thawan Dutchanee',
    desc: 'Machine learning and analysis — hospital readmission risk scoring, HDB price prediction, sales analytics — alongside communications work, essays and criticism.',
  },
];

// ---------------------------------------------------------------------------
// Featured trio — three pieces pulled to the top of the reading order.
// Slugs listed here are removed from the sections below so nothing repeats.
// ---------------------------------------------------------------------------
const featuredDefs = [
  {
    id: 'pichvai-eight-times-a-day',
    label: 'Pichvai',
    type: 'Article',
    image: '/images/pichvai-eight-times-a-day/pichvai-shrinathji-priests.jpg',
    alt: 'Pichvai painting of Shrinathji attended by priests at the Nathdwara shrine',
    desc: 'The Shrinathji temple at Nathdwara changes its paintings up to eight times a day — one for each ritual darshan.',
  },
  {
    id: 'dhoori',
    label: 'Dhoori',
    type: 'Short Story',
    image: '/images/dhoori/indian-street-crowd.jpg',
    pos: 'center 42%',
    alt: 'Dense crowd filling a narrow Indian street, photographed from above in black and white',
    desc: 'A Singapore-born traveller arrives in a remote Indian town and something is wrong. A slow-burn mystery about roots and return.',
  },
  {
    id: 'artist-once-known',
    label: 'Ajanta',
    type: 'Article',
    image: '/images/artist-once-known/ajanta-buddha-mural.jpg',
    alt: 'Fifth-century mural of the Buddha painted on the wall of an Ajanta cave',
    desc: 'The painters of Ajanta left no names. Not erasure, but philosophy: art made as offering rather than self-assertion.',
  },
];
const featured = featuredDefs
  .map((f) => ({ ...f, post: all.find((p) => p.id === f.id) }))
  .filter((f) => f.post);
const featuredIds = new Set(featured.map((f) => f.id));

// ---------------------------------------------------------------------------
// The existing magazine lineup, unchanged in behaviour — the newest essay runs
// as the Feature, the next few fill the archive grid with the latest fiction
// pinned. Anything already shown in the featured trio above is skipped so no
// piece appears on the homepage twice.
// ---------------------------------------------------------------------------
const allEssays = byDate.filter((p) => p.data.type !== 'fiction');
const essays = allEssays.filter((p) => !featuredIds.has(p.id));
const fictions = byDate.filter((p) => p.data.type === 'fiction' && !featuredIds.has(p.id));
const feature = essays[0];
const pinnedFiction = all.find((p) => p.id === 'mamas-boy') ?? fictions[0];
const firstPichvai = all.find((p) => p.id === 'pichvai-and-bhakti');
const seen = new Set();
const grid = [...essays.slice(1, 5), firstPichvai, pinnedFiction]
  .filter(Boolean)
  .filter((p) => !featuredIds.has(p.id))
  .filter((p) => (seen.has(p.id) ? false : seen.add(p.id)));

const metaDescription = 'Essays on ancient Indian art — painting, music, poetry, and architecture — and how it connects to Hindu belief and practice. Bhakti, instruments, ghazals, paintings. With the occasional look at Singaporean culture and identity.';

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short' }).toUpperCase();
const fmtYear = (d: Date) => d.getFullYear();
---

<Layout title="Ram Jeevan Vinod" description={metaDescription}>

  <h1 class="sr-only">Ram Jeevan Vinod — Written Works</h1>

  <!-- ============ PRIMARY ENTRY POINTS ============ -->
  <section class="primary wrap" aria-label="Main sections">
    {primary.map((b) => (
      <a
        class={`pblock pblock--${b.key}`}
        href={b.href}
        target={b.external ? '_blank' : undefined}
        rel={b.external ? 'noopener noreferrer' : undefined}
      >
        <div class="pblock-art">
          <img src={b.image} alt={b.alt} style={`object-position:${b.pos}`} />
          <div class="pblock-scrim" aria-hidden="true"></div>
          <div class="pblock-overlay">
            <span class="pblock-eyebrow">{b.eyebrow}</span>
            <h2 class="serif pblock-title">{b.title}</h2>
            <p class="pblock-desc">{b.desc}</p>
          </div>
        </div>
        <div class="pblock-foot">
          <span class="pblock-type kicker">{b.type}</span>
          <span class="pblock-go">{b.external ? 'flolone.com ↗' : 'View →'}</span>
        </div>
      </a>
    ))}
  </section>

  <!-- ============ FEATURED TRIO ============ -->
  <section class="featured wrap" aria-label="Featured pieces">
    <div class="mini-head">
      <span class="kicker">Featured</span>
      <div class="rule-motif" aria-hidden="true"><span class="dot"></span></div>
    </div>

    <div class="fgrid">
      {featured.map((f) => (
        <a class="fcard" href={`/blog/${f.post.id}`}>
          <div class="fcard-art">
            <img src={f.image} alt={f.alt} loading="lazy" style={f.pos ? `object-position:${f.pos}` : undefined} />
            <div class="fcard-scrim" aria-hidden="true"></div>
            <div class="fcard-overlay">
              <h3 class="serif fcard-title">{f.label}</h3>
              <p class="fcard-desc">{f.desc}</p>
            </div>
          </div>
          <div class="fcard-foot">
            <span class="fcard-type kicker">{f.type}</span>
            <span class="diamond" aria-hidden="true"></span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <div class="pattern-band" role="presentation"></div>

  <!-- ============ FEATURE ============ -->
  <section class="feature">
    <figure class="feature-art">
      {feature.data.cover && <img src={feature.data.cover} alt={feature.data.title} loading="lazy" />}
    </figure>
    <div class="feature-text">
      <div class="feature-running">
        <span class="kicker">Feature</span>
        <span class="folio">{edition} · No. {String(allEssays.length).padStart(2, '0')}</span>
      </div>
      <span class="feature-cat kicker">{feature.data.category}</span>
      <h2 class="serif feature-title">{feature.data.title}</h2>
      <div class="feature-body">
        <p>{feature.data.description}</p>
      </div>
      <p class="meta"><b>Ram Jeevan</b> &nbsp;·&nbsp; {fmt(feature.data.date)} {fmtYear(feature.data.date)} &nbsp;·&nbsp; {feature.data.readingTime}</p>
      <a href={`/blog/${feature.id}`} class="btn btn--solid">Read the essay <span>→</span></a>
      {feature.data.pull && (
        <blockquote class="feature-pull serif"><span class="qmark">“</span>{feature.data.pull}</blockquote>
      )}
    </div>
  </section>

  <!-- ============ ARCHIVE ============ -->
  <section id="archive" class="archive wrap">
    <div class="sec-head">
      <img src="/images/warli/write.png" alt="" class="chip chip--head" />
      <div>
        <span class="kicker">Selected</span>
        <h2 class="serif sec-title">In This Edition</h2>
      </div>
      <div class="rule-motif" aria-hidden="true"><span class="dot"></span></div>
    </div>

    <div class="grid">
      {grid.map((e) => (
        <a class="card" href={`/blog/${e.id}`}>
          <div class="card-img">{e.data.cover && <img src={e.data.cover} alt={e.data.title} loading="lazy" />}</div>
          <div class="card-body">
            <span class="card-cat kicker">{e.data.category}</span>
            <h3 class="serif card-title">{e.data.title}</h3>
            <p class="card-sub">{e.data.description}</p>
            <p class="card-meta folio"><span class="diamond"></span>{fmt(e.data.date)} · {e.data.readingTime}</p>
          </div>
        </a>
      ))}
    </div>

    <div class="archive-more"><a href="/blog" class="btn">Browse all essays <span>→</span></a></div>
  </section>

  <!-- ============ PORTFOLIO CTA ============ -->
  <section class="cta">
    <div class="cta-inner wrap">
      <span class="kicker cta-kicker">Portfolio</span>
      <h2 class="serif cta-title">Stories, Data &amp; Essays</h2>
      <p class="cta-dek">More than the essays: short fiction set in Singapore, data and machine-learning projects, and criticism.</p>
      <a href="/portfolio" class="btn cta-btn">View Portfolio <span>→</span></a>
    </div>
  </section>

</Layout>

<style>
  /* the masthead used to carry the page h1; keep one for the document outline */
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}

  /* ---------------- primary entry blocks ---------------- */
  .primary{display:grid;grid-template-columns:1fr 1fr;gap:38px;padding-top:56px;padding-bottom:78px}
  .pblock{display:flex;flex-direction:column;animation:rise .6s ease both;transition:transform .35s ease}
  .pblock:nth-child(2){animation-delay:.1s}
  .pblock:hover{transform:translateY(-6px)}
  .pblock:focus-visible{outline:2px solid var(--red);outline-offset:6px}

  .pblock-art{position:relative;aspect-ratio:4/5;overflow:hidden;background:#2a211a;border:1px solid var(--ink);transition:box-shadow .4s ease}
  .pblock:hover .pblock-art{box-shadow:0 28px 46px -26px rgba(30,24,19,.6)}
  .pblock-art img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .8s ease, filter .6s ease}
  .pblock:hover .pblock-art img{transform:scale(1.05)}
  /* inner hairline frame, matching the Feature block */
  .pblock-art::after{content:"";position:absolute;inset:16px;border:1px solid rgba(243,236,220,.45);pointer-events:none;z-index:2;transition:inset .45s ease}
  .pblock:hover .pblock-art::after{inset:24px}

  .pblock-scrim{position:absolute;inset:0;z-index:1;transition:opacity .45s ease}
  .pblock--cw .pblock-scrim{background:linear-gradient(to top,rgba(28,14,9,.92) 0%,rgba(28,14,9,.62) 34%,rgba(28,14,9,.06) 68%,transparent 100%)}
  .pblock--pf .pblock-scrim{background:linear-gradient(to top,rgba(26,18,10,.92) 0%,rgba(26,18,10,.58) 36%,rgba(26,18,10,.05) 70%,transparent 100%)}
  .pblock:hover .pblock-scrim{opacity:1}
  /* the extra wash that arrives on hover, so the description stays readable */
  .pblock-art::before{content:"";position:absolute;inset:0;z-index:1;opacity:0;transition:opacity .45s ease;pointer-events:none}
  .pblock--cw .pblock-art::before{background:rgba(28,14,9,.44)}
  .pblock--pf .pblock-art::before{background:rgba(26,18,10,.46)}
  .pblock:hover .pblock-art::before{opacity:1}

  .pblock-overlay{position:absolute;left:0;right:0;bottom:0;z-index:3;padding:38px 38px 34px;color:#F7F1E3}
  .pblock-eyebrow{display:inline-block;font-family:var(--sans);font-weight:700;text-transform:uppercase;letter-spacing:.2em;font-size:.68rem;margin-bottom:.7em;padding-bottom:.55em;border-bottom:1px solid rgba(247,241,227,.4)}
  .pblock--cw .pblock-eyebrow{color:var(--marigold);border-bottom-color:rgba(224,165,38,.55)}
  .pblock--pf .pblock-eyebrow{color:#E9DDC3;border-bottom-color:rgba(233,221,195,.5)}
  .pblock-title{font-weight:700;line-height:1.02;color:#FFF8EA;text-shadow:0 2px 22px rgba(20,10,6,.55)}
  .pblock--cw .pblock-title{font-size:clamp(2rem,3.9vw,3.4rem);letter-spacing:-.015em}
  .pblock--pf .pblock-title{font-size:clamp(1.9rem,3.4vw,3rem);letter-spacing:-.005em;font-weight:600}
  .pblock-desc{margin-top:.85em;max-width:38ch;font-size:.98rem;line-height:1.5;color:#EFE5D2;
    opacity:0;max-height:0;transform:translateY(10px);overflow:hidden;
    transition:opacity .4s ease, transform .45s ease, max-height .45s ease}
  .pblock:hover .pblock-desc,.pblock:focus-visible .pblock-desc{opacity:1;max-height:12em;transform:none}

  .pblock-foot{display:flex;align-items:center;justify-content:space-between;gap:16px;
    margin-top:16px;padding-top:14px;border-top:1px solid var(--line)}
  .pblock-type{font-size:.68rem;color:var(--red);letter-spacing:.16em}
  .pblock--pf .pblock-type{color:var(--indigo)}
  .pblock-go{font-family:var(--sans);font-weight:600;font-size:.7rem;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-mute);white-space:nowrap;transition:color .25s ease, transform .25s ease}
  .pblock:hover .pblock-go{color:var(--red);transform:translateX(4px)}
  .pblock--pf:hover .pblock-go{color:var(--indigo)}

  /* ---------------- featured trio ---------------- */
  .featured{padding-bottom:86px}
  .mini-head{display:flex;align-items:center;gap:22px;margin-bottom:30px}
  .mini-head .rule-motif{flex:1}

  .fgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:34px}
  .fcard{display:flex;flex-direction:column;transition:transform .3s ease}
  .fcard:hover{transform:translateY(-5px)}
  .fcard:focus-visible{outline:2px solid var(--red);outline-offset:6px}

  .fcard-art{position:relative;aspect-ratio:4/3;overflow:hidden;background:#2a211a;border:1px solid var(--ink);transition:box-shadow .35s ease}
  .fcard:hover .fcard-art{box-shadow:0 20px 32px -20px rgba(30,24,19,.5)}
  .fcard-art img{width:100%;height:100%;object-fit:cover;transition:transform .6s ease}
  .fcard:hover .fcard-art img{transform:scale(1.06)}
  .fcard-scrim{position:absolute;inset:0;z-index:1;background:linear-gradient(to top,rgba(26,16,10,.86) 0%,rgba(26,16,10,.5) 42%,rgba(26,16,10,.04) 78%,transparent 100%)}
  .fcard-art::before{content:"";position:absolute;inset:0;z-index:1;background:rgba(26,16,10,.42);opacity:0;transition:opacity .4s ease;pointer-events:none}
  .fcard:hover .fcard-art::before{opacity:1}

  .fcard-overlay{position:absolute;left:0;right:0;bottom:0;z-index:2;padding:22px 22px 20px;color:#F7F1E3}
  .fcard-title{font-weight:600;font-size:clamp(1.5rem,2.5vw,2rem);line-height:1.05;color:#FFF8EA;text-shadow:0 2px 18px rgba(20,10,6,.5)}
  .fcard-desc{margin-top:.6em;font-size:.88rem;line-height:1.45;color:#EFE5D2;
    opacity:0;max-height:0;transform:translateY(8px);overflow:hidden;
    transition:opacity .35s ease, transform .4s ease, max-height .4s ease}
  .fcard:hover .fcard-desc,.fcard:focus-visible .fcard-desc{opacity:1;max-height:11em;transform:none}

  .fcard-foot{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:14px;padding-top:12px;border-top:1px solid var(--line)}
  .fcard-type{font-size:.66rem;color:var(--red)}

  .pattern-band{height:62px;background:url("/images/madhubani-pattern.png") center/auto 150px repeat-x;border-top:1px solid var(--line);border-bottom:1px solid var(--line);opacity:.9;position:relative;z-index:1}

  /* ---------------- existing feature ---------------- */
  .feature{display:grid;grid-template-columns:1.05fr .95fr;align-items:stretch;position:relative;z-index:1}
  .feature-art{position:relative;min-height:520px;background:#2a211a;overflow:hidden}
  .feature-art img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .7s ease}
  .feature:hover .feature-art img{transform:scale(1.04)}
  .feature-art::after{content:"";position:absolute;inset:14px;border:1px solid rgba(243,236,220,.5);pointer-events:none;transition:inset .45s ease}
  .feature:hover .feature-art::after{inset:22px}
  .feature-text{padding:64px 56px;background:var(--paper-2);display:flex;flex-direction:column}
  .feature-running{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line);padding-bottom:12px;margin-bottom:24px}
  .feature-cat{color:var(--red)}
  .feature-title{font-weight:700;font-size:clamp(2rem,3.4vw,3rem);line-height:1.06;margin:.25em 0 .55em;color:var(--ink)}
  .feature-body{font-size:1.06rem;color:var(--ink-soft);max-width:54ch}
  .feature-body p:first-of-type::first-letter{font-family:var(--display);font-weight:800;float:left;font-size:3.6rem;line-height:.78;padding:.06em .12em 0 0;color:var(--red)}
  .meta{font-family:var(--sans);font-size:.76rem;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-mute);margin:1.4em 0 1.6em}
  .meta b{color:var(--ink)}
  .feature-pull{margin-top:30px;padding-top:22px;border-top:1px solid var(--line);font-style:italic;font-size:1.3rem;line-height:1.3;color:var(--ink)}
  .qmark{color:var(--red);font-size:1.4em;line-height:0;margin-right:.04em;vertical-align:-.25em}

  /* ---------------- archive ---------------- */
  .archive{padding:88px 32px}
  .sec-head{display:flex;align-items:center;gap:20px;margin-bottom:46px}
  .chip--head{width:54px;height:54px;border:1px solid var(--red-deep)}
  .sec-title{font-weight:700;font-size:clamp(1.8rem,3vw,2.6rem);line-height:1;color:var(--ink)}
  .sec-head .rule-motif{flex:1}
  .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:52px 38px}
  .card{display:flex;flex-direction:column;transition:transform .3s ease}
  .card:hover{transform:translateY(-6px)}
  .card-img{position:relative;aspect-ratio:4/3;overflow:hidden;background:#2a211a;border:1px solid var(--ink);transition:box-shadow .35s ease}
  .card:hover .card-img{box-shadow:0 20px 32px -20px rgba(30,24,19,.5)}
  .card-img::after{content:"";position:absolute;inset:0;background:linear-gradient(to top, rgba(190,58,36,.22), transparent 55%);opacity:0;transition:opacity .4s ease;pointer-events:none}
  .card:hover .card-img::after{opacity:1}
  .card-img img{width:100%;height:100%;object-fit:cover;transition:transform .5s ease, filter .5s ease}
  .card:hover .card-img img{transform:scale(1.05);filter:saturate(1.1)}
  .card-body{padding-top:18px}
  .card-cat{font-size:.66rem;color:var(--red)}
  .card-title{font-weight:600;font-size:1.55rem;line-height:1.1;margin:.28em 0 .2em;color:var(--ink);transition:color .25s}
  .card:hover .card-title{color:var(--red)}
  .card-sub{font-size:.96rem;color:var(--ink-soft);margin-bottom:1em}
  .card-meta{display:flex;align-items:center;gap:9px;border-top:1px solid var(--line);padding-top:12px}
  .archive-more{text-align:center;margin-top:60px}

  .diamond{width:6px;height:6px;transform:rotate(45deg);background:var(--marigold);flex:0 0 auto;transition:transform .45s ease, background .3s}
  .card:hover .diamond,.fcard:hover .diamond{transform:rotate(225deg);background:var(--red)}

  /* ---------------- cta ---------------- */
  .cta{position:relative;z-index:1;background:#C24A1E url("/images/banner-warli.png") center/cover no-repeat;text-align:center}
  .cta::before{content:"";position:absolute;inset:0;background:rgba(40,18,8,.34)}
  .cta-inner{position:relative;z-index:1;padding:104px 32px;max-width:680px}
  .cta-kicker{color:#FCE3B0}
  .cta-title{font-weight:700;color:#FFF6E6;font-size:clamp(2.2rem,4.4vw,3.4rem);line-height:1.05;margin:.3em 0 .4em;text-shadow:0 2px 18px rgba(40,18,8,.4)}
  .cta-dek{color:#FBEACF;max-width:480px;margin:0 auto 2em;font-size:1.08rem}
  .cta-btn{border-color:#FCE3B0;color:#FFF6E6}
  .cta-btn:hover{background:#FCE3B0;color:#7a2a10}

  /* ---------------- responsive ---------------- */
  @media(max-width:1080px){
    .primary{gap:28px}
    .pblock-overlay{padding:30px 28px 26px}
    .fgrid{gap:26px}
  }
  @media(max-width:900px){
    .primary{grid-template-columns:1fr;gap:44px;padding-top:40px;padding-bottom:64px}
    /* square once stacked — wide enough to stay generous, tall enough that the
       two portrait-format hero images aren't cut through the middle */
    .pblock-art{aspect-ratio:1/1}
    .feature{grid-template-columns:1fr}
    .feature-art{min-height:340px}
    .feature-text{padding:44px 30px}
    .grid{grid-template-columns:repeat(2,1fr);gap:40px 28px}
  }
  @media(max-width:680px){
    .fgrid{grid-template-columns:1fr;gap:34px}
    .fcard-art{aspect-ratio:16/10}
    .featured{padding-bottom:62px}
    .pblock-art{aspect-ratio:4/5}
    .grid{grid-template-columns:1fr}
    .pblock-foot{flex-wrap:wrap;gap:8px}
  }

  /* On touch devices there is no hover, so the descriptions are always shown. */
  @media(hover:none){
    .pblock-desc,.fcard-desc{opacity:1;max-height:none;transform:none}
    .pblock-art::before,.fcard-art::before{opacity:1}
  }
</style>
